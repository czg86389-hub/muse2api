# ==========================================
# MUSE2API 配置环境变量示例
# 复制为 .env 即可生效: cp .env.example .env
# ==========================================

# [必填/选填] 管理与 API 鉴权密钥（以 m2a_ 开头）。
# 若留空，程序首次启动时会自动生成一个高强度随机密钥并打印到控制台日志。
MUSE2API_KEY=m2a_your_secret_admin_key_here

# 服务监听地址与端口（Docker 容器内需设为 0.0.0.0）
MUSE2API_HOST=0.0.0.0
MUSE2API_PORT=18610

# 外部公开访问地址（供下游客户端接入及管理页拼接使用，如 https://api.yourdomain.com）
# 留空时，管理页面将自动使用当前浏览器访问的主机与端口
MUSE2API_PUBLIC_BASE=

# Chromium 浏览器可执行文件路径
# Linux/Docker 通常为 /usr/bin/chromium 或 /usr/bin/chromium-browser
# Windows 本地运行可设为 Chrome 完整路径或留空自动查找
MUSE2API_CHROMIUM=/usr/bin/chromium

# CDP 远程调试通信端口
MUSE2API_CDP_PORT=19210

# 任务超时控制（单位：秒）
MUSE2API_IMAGE_TIMEOUT=240
MUSE2API_VIDEO_TIMEOUT=600
MUSE2API_AUDIO_TIMEOUT=180
MUSE2API_CHAT_TIMEOUT=300

# Default voice description used by /v1/audio/speech when the request has no voice.
MUSE2API_AUDIO_VOICE=自然清晰的女声

# Global system prompt (off by default). When enabled, it is attached to every
# request sent to Muse: chat, Responses, images, videos and speech.
# Use \n for line breaks in this single-line .env value; the admin Settings page
# stores multi-line text in data/settings.json and takes precedence after saving.
MUSE2API_SYSTEM_PROMPT_ENABLED=0
MUSE2API_SYSTEM_PROMPT=Session isolation\nEverything in this chat session is independent. Do not use memory or materials from other sessions.\nDo not save anything from this session to memory. Do not update MEMORY.md, preferences, or goals from this chat. Treat everything here as temporary and session-only.

# 最大并发生成任务数（支持随服务器资源自由调高，默认 2）
MUSE2API_CONCURRENCY=2

# 是否对后台禁用的账号执行自动保活（0=关闭，1=开启）
# 开启后已禁用账号仍会执行静默保活与会话续期，但不会被路由参与正常生成与对话
MUSE2API_KEEPALIVE_DISABLED_ACCOUNTS=0

# 参考图安全开关（默认安全；仅可信单用户部署才考虑显式设为 1）
# 1：允许 API 请求读取服务器本地文件路径
MUSE2API_REF_IMAGE_LOCAL_FILES=0
# 1：允许 API 请求下载内网/本机 URL；0 时逐跳检查并仅允许公网 IP
MUSE2API_REF_IMAGE_PRIVATE_FETCH=0

# 媒体清理（默认开启：保留 1 天，总量最多 1 GB，每 60 分钟扫描一次）
# 天数 0 = 不按年龄删除；GB 0 = 不限制总容量。
# 管理页 Settings 保存后以 data/settings.json 为准。
MUSE2API_MEDIA_CLEANUP_ENABLED=1
MUSE2API_MEDIA_RETENTION_DAYS=1
MUSE2API_MEDIA_MAX_GB=1
MUSE2API_CLEANUP_INTERVAL_MINUTES=60
# 启动时清理 data/debug-*.json 的保留天数
MUSE2API_DEBUG_RETENTION_DAYS=7
